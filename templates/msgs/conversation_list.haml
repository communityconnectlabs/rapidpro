-extends "smartmin/list.html"
-load smartmin temba i18n contacts compress humanize static

-block page-title
  {{ title }}

-block temba-store
  -if not is_spa
    %temba-store(
      completion="/mr/docs/{{ LANGUAGE_CODE }}/editor.json"
      fields="/api/v2/fields.json"
      globals="/api/v2/globals.json"
      groups="/api/v2/groups.json"
    )

-block extra-style
  {{block.super}}
  :css
    temba-select[name='ticket-status'] {
      margin-top: -1em;
    }
    
    temba-contact-chat {
      transition: all 200ms ease-in-out;
      transition-delay: 200ms;
    }

    .empty {
      position: absolute;
      transition: all 200ms ease-in-out;
      transition-delay: 200ms;
      opacity: 0;
      padding: 3px 40px;
    }

    .empty h2 {
      font-size: 36px;
      margin-top: 16px;
    }

    .popper {
      font-size: 48px;
      display: inline;
    }

    temba-select[name='ticket-status'] {
      margin-bottom: 1em;
    }

    .ticket-list {
      flex-basis: 300px; 
      flex-grow: 0; 
      flex-shrink: 0;
      transition: all 200ms ease-in;
    }

    temba-menu {
      height: 100%;
    }
    
    @media only screen and (max-width: 850px) {
      .ticket-list {
        flex-basis: 200px; 
      }

    }

    @media only screen and (max-width: 768px) {
      .ticket-list {
        flex-basis: 125px; 
      }
      .widget-container {          
        margin-top:16px !important;
        padding-top:0px !important;
        margin-bottom:-120px;
        padding-bottom:120px;
      }
    }

    .list-item:hover, .selected {
      background: var(--color-link-primary-hover);
      color: var(--color-text-light);
      border-radius: var(--curvature-widget);
    }

    .template-item:hover {
      color: unset !important;
    }

    .template-item:hover > temba-modax > .icon-remove-2, .template-item:hover > .name, .template-item:hover > temba-modax > .modax-body {
      color: rgb(var(--primary-rgb));
    }

    .conversation-filter {
      font-weight: 500;
      font-size: 0.75rem;
      text-align: left;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }

    .is-active, .is-active:hover {
      color: #999999;
      cursor: text;
      text-decoration: none;
    }

    .line16px {
      line-height: 16px;
    }

-block extra-script
  {{ block.super }}
  %script{"src": "https://cdn.ably.com/lib/ably.min-2.js"}
  %audio#notification{"src": "{% static '/sounds/new-notification.mp3' %}"}
  :javascript
    function hideBadge(e) {
      let badge = e.target.querySelector(".badge");
      if (badge) {
        e.target.removeChild(badge);
      }
    }

    function selectChat(contactUUID) {
      const url = new URL(window.location);
      const params = new URLSearchParams(url.search);

      // Modify or add query params
      var chat = document.querySelector("temba-contact-chat");
      var archiveURL = "{% url 'msgs.conversation_archive' 'uuid' %}";
      var unreadURL = "{% url 'msgs.conversation_unread' 'uuid' %}";
      var sendAttachmentURL = "{% url 'msgs.conversation_send_attachment' 'uuid' %}";
      if(contactUUID && contactUUID !== "null") {
        chat.contactUUID = contactUUID;
        chat.customActions = [
          {
            label: "Unread",
            icon: "inbox",
            callback: () => {
              const unreadModal = document.querySelector("#unread-modal");
              unreadModal.endpoint = unreadURL.replace("uuid", contactUUID);
              unreadModal.open = true;
            }
          },
          {
            label: "Archive",
            icon: "archive",
            callback: () => {
              const archiveModal = document.querySelector("#archive-modal");
              archiveModal.endpoint = archiveURL.replace("uuid", contactUUID);
              archiveModal.open = true;
            }
          },
        ];
        chat.attachmentAccept = ".pdf, .doc, .docx, .xls, .xlsx, .ppt, .pptx, .txt, .odt, image/*, audio/*, video/*";
        chat.onAttachmentSelected = (e) => {
          let loading = document.createElement("temba-loading");
          loading.size = 10;
          loading.units = 6;

          let file = e.target.files[0];
          if (file) {
            if (file.type.startsWith("image") && file.size > 5 * 1024 * 1024 || !file.type.startsWith("image") && file.size > 512 * 1024) {
              document.querySelector("temba-contact-chat").shadowRoot.querySelector("input[type='file']").value = '';
              document.querySelector("#info-dialog-body").innerText = `File "${file.name}" exceeds the size limit (${file.type.startsWith("image") ? "5 MB" : "500KB"}).`;
              document.querySelector('#info-dialog').open = true;
              return;
            }

            let controls = document.querySelector("temba-contact-chat").shadowRoot.querySelector(".chatbox>div");
            controls.querySelector("temba-tip").style.marginRight = 'auto';
            controls.querySelector("temba-tip").style.paddingRight = '43px';
            controls.querySelector("temba-button").style.marginLeft = 'auto';
            loading.style.marginLeft = 'auto';
            loading.style.marginRight = 'auto';
            controls.insertBefore(loading, controls.querySelector("temba-button"));

            let formData = new FormData();
            formData.append("attachment", file);
            fetch(
              sendAttachmentURL.replace("uuid", contactUUID),
              {
                method: "POST",
                body: formData,
                headers: {
                  "X-CSRFToken": document.cookie.split("; ").filter((c) => c.startsWith("csrftoken="))[0]?.replace("csrftoken=", "")
                }
              }
            )
            .then(r => r.json())
            .then(() => {
              document.querySelector("temba-contact-chat")
              .shadowRoot.querySelector("input[type='file']")
              .value = '';
            }).catch(() => {
              document.querySelector("temba-contact-chat").shadowRoot.querySelector("input[type='file']").value = '';
              document.querySelector("#info-dialog-body").innerText = `Failed to send attachment.`;
              document.querySelector('#info-dialog').open = true;
            }).finally(() => {
              document.querySelector("temba-contact-chat")
              .shadowRoot.querySelector(".chatbox>div")
              .removeChild(loading);
            });
          }
        };
        params.set('contactUUID', contactUUID);
      } else {
        chat.contactUUID = null;
        chat.currentContact = null;
        chat.attachmentAccept = null;
        chat.customActions = null;
        params.delete('contactUUID');
      }

      // Update the URL without reloading the page
      window.history.pushState({}, '', `${url.pathname}${Array.from(params).length ? '?': ''}${params}`);

      // Mark option as selected
      const options = document.querySelectorAll(".chats-list > .list-item");
      options.forEach(option => {
        option.classList.remove("selected");
        if (option.getAttribute("data_contact_uuid") === contactUUID) {
          option.classList.add("selected");
        }
      });
    }

    function clearSearch() {
      const url = new URL(window.location);
      url.searchParams.delete('search');
      url.searchParams.delete('archived');
      window.location.href = url.toString();
    }

    function clearSearchArchived() {
      const url = new URL(window.location);
      url.searchParams.delete('search');
      url.searchParams.set('archived', 'true');
      window.location.href = url.toString();
    }

    function filterChats(chatType) {
      const url = new URL(window.location);
      const params = new URLSearchParams(url.search);
      params.set("chats", chatType);
      window.location.href = `${url.pathname}${Array.from(params).length ? '?': ''}${params}`;
    }

    function initFilter(params) {
      let selector = `.conversation-filter .${params.get("chats") === "my" ? "my" : "all"}-chats`;
      let filter = document.querySelector(selector);
      filter.classList.add("is-active");
    }

    function initErrorDialog() {
      let dialog = document.querySelector('#info-dialog');
      dialog.primaryButtonName = null;
      dialog.cancelButtonName = "OK";
    }

    function showNotification(message) {
      const show = () => {
        const notification = new Notification("You have got new message:", {body: message});
        notification.onclick = () => { window.focus(); notification.close(); };
        document.querySelector("#notification")?.play();
        console.info(message);
      }
      if (Notification.permission !== "granted") {
        Notification.requestPermission().then(permission => {
          if (permission === "granted") show();
        });
      } else {
        show();
      }
    }

    function handleNewUnreadMessage(event) {
      let [conversationID, _] = event.data.split(":");
      let conversationItem = document.querySelector(`[data_chat_id="${conversationID}"]`);
      if (conversationItem) {
        let badge = conversationItem.querySelector("div.badge.line16px");
        if (!badge) {
          badge = document.createElement("div");
          badge.classList.add("badge", "line16px");
          badge.innerText = "0";
          conversationItem.appendChild(badge);
        }
        badge.innerText = Number.parseInt(badge.innerText) + 1;
        showNotification(`The new message from ${conversationItem.innerText}`);
      }
    }

    function setupPubSupListener() {
      const realtimeClient = new Ably.Realtime({
        key: '{{ABLY_API_KEY}}',
        clientId: 'conversations-listener-{{request.user.id|default:''}}'
      });
      realtimeClient.connection.once('connected', () => {
        let channel = realtimeClient.channels.get("courier");
        channel.subscribe("new_messages", handleNewUnreadMessage);
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      const url = new URL(window.location);
      const params = new URLSearchParams(url.search);
      const contactUUID = params.get('contactUUID');
      initFilter(params);
      selectChat(contactUUID);
      initErrorDialog();
      setupPubSupListener();
    });

-block content
    #pjax
      -block pjax
        .lp-frame
          .left
            .flex.flex-col
              -if org_perms.msgs.conversation_start
                .w-64.mr-5
                  %temba-modax#send-message-modal{ header:'{% trans "Send Message" %}', endpoint:"{% url 'msgs.conversation_start' %}" }
                    .button-primary.block
                      -trans "Send Message"
              .lp-nav.upper
                .lp-nav-item{'class': 'font-normal', 'onclick': 'clearSearch()' }
                  .name
                    Chats
                  .count
                    {{ chats_count | intcomma }}
                .lp-nav-item{'class': 'font-normal', 'onclick': 'clearSearchArchived()' }
                  .name
                    Archived
                  .count
                    {{ archived_count | intcomma }}

              -if templates
                .lp-nav.lower
                  .font-normal.uppercase.text-xs.text-gray-500.pb-1
                    - trans "Templates"
                  .inner-scroll
                    -for template in templates
                      .lp-nav-item.template-item{ class:'{% if current_label.id == node.obj.id %}font-normal{% endif %}' }
                        -if org_perms.msgs.conversation_update_template
                          %temba-modax.name{ header: "{% trans 'Update Template' %}", endpoint: "{% url 'msgs.conversation_update_template' template.id %}"}
                            {{ template.name }}
                          -if org_perms.msgs.conversation_delete_template
                            %temba-modax.ml-auto.delete-template-modal{ header:'{% trans "Delete Template" %}', endpoint:"{% url 'msgs.conversation_delete_template' template.id %}"}
                              .icon-remove-2
                        -elif org_perms.msgs.conversation_preview_template
                          %temba-modax.name{ header: "{% trans 'Template Info' %}", endpoint: "{% url 'msgs.conversation_preview_template' template.id %}"}
                            {{ template.name }}

              .flex-grow
                -if org_perms.msgs.conversation_create_template
                  %temba-modax#create-label-modal{ header:'{% trans "Create Template" %}', endpoint:"{% url 'msgs.conversation_create_template' %}"}
                    .button-light.block.mt-3
                      - trans "Create Template"

          .right
            .flex.widget-container(style="{% if is_spa%}margin:0;padding:0;height:100%{%else%}height:calc(100vh - 265px);margin-top:-27px;margin-bottom: -27px;{%endif%}")
              .ticket-list.flex.flex-col(class="{% if is_spa%} {% else %}m-4 pt-4 mr-2{%endif%}")
                %form#search-form.mb-4(method="get")
                  %temba-textinput.w-full(placeholder='{% trans "Search" %}' name="search" value="{{search}}")

                .flex.justify-end.w-full
                  .conversation-filter
                    %a.my-chats(href="#" onclick='event.stopPropagation();filterChats("my");return false;')
                      -trans "My Chats"
                    |
                    %a.all-chats(href="#" onclick='event.stopPropagation();filterChats("all");return false;')
                      -trans "All Chats"

                .flex.flex-grow.relative(style="max-height: calc(100% - 49px);")
                  %ul.w-full.p-1.chats-list.overflow-y-auto(style="border: 1px solid var(--color-widget-border);border-radius: var(--curvature-widget);background: var(--color-widget-bg);")
                    -if not chats
                      -trans "No chats found"
                    -else
                      -for chat in chats
                        %li.w-full.p-1.cursor-pointer.flex.flex-row.justify-between.list-item(onclick='hideBadge(event);selectChat("{{chat.contact.uuid}}")' data_contact_uuid='{{chat.contact.uuid}}' data_chat_id='{{chat.id}}')
                          =chat.contact
                          -if chat.unread_count
                            .badge.line16px
                              =chat.unread_count

              .flex-grow.flex-col.h-full(class="{% if is_spa %}ml-4{%else%}py-4 pb-4 pr-4{% endif %}")
                %temba-contact-chat.h-full(agent="{{request.user.email}}" monitor="true")
        %temba-modax#archive-modal{ header: '{% trans "Update Conversation" %}' }
        %temba-modax#unread-modal{ header: '{% trans "Mark as Unread" %}' }
        %temba-dialog#info-dialog{ header: '{% trans "Attachment Error" %}' }
          #info-dialog-body.p-5
            -trans "Failed to send attachment."
          %div{ slot: "footer", onclick: "document.querySelector('#info-dialog').open = false" }
            OK
