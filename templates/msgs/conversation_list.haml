-extends "smartmin/list.html"
-load smartmin temba i18n contacts compress humanize

-block page-title
  {{ title }}

-block temba-store
  -if not is_spa
    %temba-store(
      completion="/mr/docs/{{ LANGUAGE_CODE }}/editor.json"
      fields="/api/v2/fields.json"
      globals="/api/v2/globals.json"
      groups="/api/v2/groups.json")

-block extra-style
  {{block.super}}
  :css
    temba-select[name='ticket-status'] {
      margin-top: -1em;
    }
    
    temba-contact-chat {
      transition: all 200ms ease-in-out;
      transition-delay: 200ms;
    }

    .empty {
      position: absolute;
      transition: all 200ms ease-in-out;
      transition-delay: 200ms;
      opacity: 0;
      padding: 3px 40px;
    }

    .empty h2 {
      font-size: 36px;
      margin-top: 16px;
    }

    .popper {
      font-size: 48px;
      display: inline;
    }

    temba-select[name='ticket-status'] {
      margin-bottom: 1em;
    }

    .ticket-list {
      flex-basis: 300px; 
      flex-grow: 0; 
      flex-shrink: 0;
      transition: all 200ms ease-in;
    }

    temba-menu {
      height: 100%;
    }
    
    @media only screen and (max-width: 850px) {
      .ticket-list {
        flex-basis: 200px; 
      }

    }

    @media only screen and (max-width: 768px) {
      .ticket-list {
        flex-basis: 125px; 
      }
      .widget-container {          
        margin-top:16px !important;
        padding-top:0px !important;
        margin-bottom:-120px;
        padding-bottom:120px;
      }
    }

    .list-item:hover, .selected {
      background: var(--color-link-primary-hover);
      color: var(--color-text-light);
      border-radius: var(--curvature-widget);
    }

-block extra-script
  {{ block.super }}

  :javascript
    function selectChat(contactUUID) {
      const url = new URL(window.location);
      const params = new URLSearchParams(url.search);

      // Modify or add query params

      var chat = document.querySelector("temba-contact-chat");
      if(contactUUID && contactUUID !== "null") {
        chat.contactUUID = contactUUID;
        params.set('contactUUID', contactUUID);
      } else {
        chat.contactUUID = null;
        chat.currentContact = null;
        params.delete('contactUUID');
      }

      // Update the URL without reloading the page
      window.history.pushState({}, '', `${url.pathname}${Array.from(params).length ? '?': ''}${params}`);

      // Mark option as selected
      const options = document.querySelectorAll(".chats-list > .list-item");
      options.forEach(option => {
        option.classList.remove("selected");
        if (option.getAttribute("data_contact_uuid") === contactUUID) {
          option.classList.add("selected");
        }
      });
    }

    function handleContactHistoryUpdated(event) {
      // tell our list to refresh since we know things happened
      var tickets = document.querySelector("temba-ticket-list");
      if (tickets) {
        tickets.refresh();
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const url = new URL(window.location);
      const params = new URLSearchParams(url.search);
      const contactUUID = params.get('contactUUID');
      selectChat(contactUUID);
    });

-block content
    #pjax
      -block pjax
        .lp-frame
          .left
            .flex.flex-col
              -if org_perms.msgs.conversation_start
                .w-64.mr-5
                  %temba-modax#send-message-modal{ header:'{% trans "Send Message" %}', endpoint:"{% url 'msgs.conversation_start' %}" }
                    .button-primary.block
                      -trans "Send Message"
              .lp-nav.upper
                .lp-nav-item{'class': 'font-normal' }
                  .name
                    Chats
                  .count
                    {{ chats_count | intcomma }}

              -if templates
                .lp-nav.lower
                  .font-normal.uppercase.text-xs.text-gray-500.pb-1
                    - trans "Templates"
                  .inner-scroll
                    -for template in templates
                      .lp-nav-item{ class:'{% if current_label.id == node.obj.id %}font-normal{% endif %}' }
                        .name
                          {{ template.name }}
                        -if org_perms.msgs.conversation_delete_template
                          %a.icon-remove-2.ml-auto{href: "{% url 'msgs.conversation_delete_template' template.id %}"}


              .flex-grow
                -if org_perms.msgs.conversation_create_template
                  %temba-modax#create-label-modal{ header:'{% trans "Create Template" %}', endpoint:"{% url 'msgs.conversation_create_template' %}"}
                    .button-light.block.mt-3
                      - trans "Create Template"

          .right
            .flex.widget-container(style="{% if is_spa%}margin:0;padding:0;height:100%{%else%}height:calc(100vh - 265px);margin-top:-27px;margin-bottom: -27px;{%endif%}")
              .ticket-list.flex.flex-col(class="{% if is_spa%} {% else %}m-4 pt-4 mr-2{%endif%}")
                %form#search-form.mb-4(method="get")
                  %temba-textinput.w-full(placeholder='{% trans "Search" %}' name="search" value="{{search}}")

                .flex.flex-grow(style="max-height:100%;")
                  %ul.w-full.p-1.chats-list(style="border: 1px solid var(--color-widget-border);border-radius: var(--curvature-widget);background: var(--color-widget-bg);")
                    - for chat in chats
                      %li.w-full.p-1.cursor-pointer.list-item(onclick='selectChat("{{chat.contact.uuid}}")' data_contact_uuid='{{chat.contact.uuid}}')
                        =chat.contact

              .flex-grow.flex-col.h-full(style="" class="{% if is_spa %}ml-4{%else%}py-4 pb-4 pr-4{% endif %}")
                %temba-contact-chat.h-full(agent="{{request.user.email}}" -temba-refreshed="handleContactHistoryUpdated" monitor="true")
